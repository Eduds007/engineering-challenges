# .env.example — names only, never commit real keys or a real .env file.
# Copy this to .env and fill in values: `cp .env.example .env`
#
# Zero-setup option: `python3 main.py --no-llm` runs the full rule-based pipeline with
# no API calls at all and no .env required — every value below is optional on top of that.
#
# How a call resolves, in order: the model on LLM_PROVIDER below -> that provider's own
# built-in fallback models (hardcoded in scripts/llm_client.py, no config needed) -> if
# every one of those fails (e.g. a free-tier daily quota is exhausted), this machine's own
# `claude -p` (Claude Code CLI) as a last resort, using its own login — no key needed for
# that step, only a working `claude` CLI on PATH.

# Which HTTP provider scripts/llm_client.py talks to first: "groq" or "openrouter".
LLM_PROVIDER=groq

# --- Groq --- free tier, generous per-minute limits. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional — defaults to openai/gpt-oss-120b if left blank. Any Groq chat model works.
GROQ_MODEL=

# --- OpenRouter --- broader free-model catalog, but a low daily cap on free models
# (as few as 50 requests/day on some accounts) — expect it to run out mid-pipeline.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional — defaults to poolside/laguna-s-2.1:free if left blank. Must end in ":free"
# to actually be free; any other OpenRouter model works but is billed.
OPENROUTER_MODEL=

# Retries per model before moving on (to the next fallback model, then to claude-cli).
# Default 5, ~60s max backoff per retry. Turn down to 1 when the configured provider is
# *known* dead for the day (a hard daily quota, not a transient blip) so a doomed retry
# loop doesn't burn minutes before falling through to claude-cli.
LLM_MAX_RETRIES=5

# Model the claude-cli last-resort fallback uses — an alias ("haiku", "sonnet") or a full
# model name. Only invoked if every candidate on LLM_PROVIDER above has failed. Needs the
# `claude` CLI installed and logged in on this machine (no key here — it uses your own
# Claude Code login, not a separate API key). If you don't have Claude Code, leave this as
# the default; the fallback will just also fail and the pipeline logs it and moves on to
# the next document rather than crashing.
CLAUDE_CLI_MODEL=haiku
